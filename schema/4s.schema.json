  "snapshot": {
    "$defs": {
      "AudioStatus": {
        "properties": {
          "backend": {
            "description": "`cpal` for a real device, `null` for headless real-time pacing.",
            "type": "string"
          },
          "channels": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "device": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "running": {
            "type": "boolean"
          },
          "sample_rate": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "backend",
          "sample_rate",
          "channels",
          "running"
        ],
        "type": "object"
      },
      "ControllerState": {
        "properties": {
          "device": {
            "description": "Hardware currently attached as a Livid Block, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "follow": {
            "description": "When true, the page follows the playhead while playing.",
            "type": "boolean"
          },
          "knob_mode": {
            "$ref": "#/$defs/KnobMode"
          },
          "knob_params": {
            "description": "Parameter path each knob currently controls (knob N -> track N).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "leds": {
            "description": "8 rows x 8 columns of LED values (0 = off, 1 = on).",
            "items": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array"
          },
          "page": {
            "description": "Which 8-step page the grid shows (0 = steps 1-8, 1 = steps 9-16, ...).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "knob_mode",
          "knob_params",
          "page",
          "follow",
          "leds"
        ],
        "type": "object"
      },
      "DeviceKind": {
        "oneOf": [
          {
            "const": "livid_block",
            "description": "Grid + knobs mapped onto the sequencer, LEDs driven.",
            "type": "string"
          },
          {
            "const": "generic_drums",
            "description": "General MIDI drum notes trigger voices.",
            "type": "string"
          }
        ]
      },
      "KnobMode": {
        "description": "What the 8 knobs control. Knob N always maps to track N.",
        "enum": [
          "volume",
          "tune",
          "decay",
          "tone"
        ],
        "type": "string"
      },
      "MidiConnection": {
        "properties": {
          "input": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/DeviceKind"
          },
          "output": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "input",
          "kind"
        ],
        "type": "object"
      },
      "ProjectInfo": {
        "properties": {
          "dirty": {
            "type": "boolean"
          },
          "path": {
            "description": "Engine-side path of the project bundle, if saved/loaded.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "dirty"
        ],
        "type": "object"
      },
      "TrackPattern": {
        "description": "Steps for one track. Each entry is 0 (off), 1 (on), or 2 (accent).\nAlways `MAX_STEPS` long; `sequencer.length` sets how many are played.",
        "properties": {
          "steps": {
            "items": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "voice": {
            "$ref": "#/$defs/Voice"
          }
        },
        "required": [
          "voice",
          "steps"
        ],
        "type": "object"
      },
      "TransportState": {
        "properties": {
          "playing": {
            "type": "boolean"
          },
          "step": {
            "description": "Current step while playing.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "playing"
        ],
        "type": "object"
      },
      "Voice": {
        "description": "The eight TR-808-style drum voices. Order is the track order.",
        "enum": [
          "kick",
          "snare",
          "clap",
          "closed_hat",
          "open_hat",
          "low_tom",
          "high_tom",
          "cowbell"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Full engine state. Subscribers apply events with `seq` greater than this.",
    "properties": {
      "audio": {
        "$ref": "#/$defs/AudioStatus"
      },
      "controller": {
        "$ref": "#/$defs/ControllerState"
      },
      "midi": {
        "items": {
          "$ref": "#/$defs/MidiConnection"
        },
        "type": "array"
      },
      "params": {
        "additionalProperties": {
          "format": "double",
          "type": "number"
        },
        "type": "object"
      },
      "pattern": {
        "items": {
          "$ref": "#/$defs/TrackPattern"
        },
        "type": "array"
      },
      "project": {
        "$ref": "#/$defs/ProjectInfo"
      },
      "seq": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "transport": {
        "$ref": "#/$defs/TransportState"
      }
    },
    "required": [
      "seq",
      "transport",
      "params",
      "pattern",
      "controller",
      "midi",
      "project",
      "audio"
    ],
    "title": "Snapshot",
    "type": "object"
  }
}
